  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Crée un utilisateur non confirmé et envoie un email de confirmation (Gmail SMTP)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"201 Created\", function(){ pm.response.to.have.status(201); });",
                  "const user = pm.response.json();",
                  "pm.test(\"User payload ok\", function(){",
                  "  pm.expect(user).to.have.property(\"id\");",
                  "  pm.expect(user).to.have.property(\"email\", pm.environment.get(\"email\").toLowerCase());",
                  "});",
                  "// Astuce: le lien de confirmation arrive par email (Gmail).",
                  "// Si vous logguez le token côté backend ou le récupérez via logs, placez-le ci-dessous:",
                  "// pm.environment.set('confirm_token', '<TOKEN>');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Resend Confirmation (facultatif)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/resend-confirmation", "host": ["{{base_url}}"], "path": ["auth","resend-confirmation"] },
            "body": { "mode": "raw", "raw": "{ \"email\": \"{{email}}\" }" },
            "description": "Renvoie un email de confirmation si besoin."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test(\"200 OK\", ()=> pm.response.to.have.status(200));"], "type": "text/javascript" }
            }
          ]
        },
        {
          "name": "Confirm Email (via token) - GET",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/confirm/{{confirm_token}}",
              "host": ["{{base_url}}"],
              "path": ["auth","confirm","{{confirm_token}}"]
            },
            "description": "Ouvre le lien reçu par email. Placez le token dans confirm_token."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if(!pm.environment.get('confirm_token')){",
                  "  pm.execution.setNextRequest(null);",
                  "  console.warn('⚠️ confirm_token manquant. Renseignez-le depuis l’email.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", ()=> pm.response.to.have.status(200));",
                  "const user = pm.response.json();",
                  "pm.test(\"Email confirmé\", ()=> pm.expect(user.email_confirmed).to.be.true);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login (envoi OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] },
            "body": { "mode": "raw", "raw": "{ \"email\": \"{{email}}\", \"password\": \"{{password}}\" }" },
            "description": "Vérifie credentials et envoie un OTP par email."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", ()=> pm.response.to.have.status(200));",
                  "pm.test(\"Message OTP\", ()=> pm.expect(pm.response.json().message).to.include('OTP'));",
                  "// Entrez l’OTP reçu par email dans la variable environment 'otp_code'."
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Verify OTP → Access & Refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/verify-otp", "host": ["{{base_url}}"], "path": ["auth","verify-otp"] },
            "body": { "mode": "raw", "raw": "{ \"email\": \"{{email}}\", \"code\": \"{{otp_code}}\" }" },
            "description": "Échange OTP contre tokens JWT."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if(!pm.environment.get('otp_code')){",
                  "  pm.execution.setNextRequest(null);",
                  "  console.warn('⚠️ otp_code manquant. Renseignez le code reçu par email.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", ()=> pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.environment.set('access_token', data.access_token || '');",
                  "pm.environment.set('refresh_token', data.refresh_token || '');",
                  "pm.test(\"Access token présent\", ()=> pm.expect(pm.environment.get('access_token')).to.have.lengthOf.above(10));",
                  "pm.test(\"Refresh token présent\", ()=> pm.expect(pm.environment.get('refresh_token')).to.have.lengthOf.above(10));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Refresh Access Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{refresh_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth","refresh"] },
            "body": { "mode": "raw", "raw": "" },
            "description": "Utilise le refresh token pour obtenir un nouvel access."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", ()=> pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.environment.set('access_token', data.access_token || '');",
                  "pm.test(\"Nouveau access token\", ()=> pm.expect(pm.environment.get('access_token')).to.have.lengthOf.above(10));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Request Password Reset (email)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/request-password-reset", "host": ["{{base_url}}"], "path": ["auth","request-password-reset"] },
            "body": { "mode": "raw", "raw": "{ \"email\": \"{{email}}\" }" },
            "description": "Envoie un email avec un token de reset (lien)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", ()=> pm.response.to.have.status(200));",
                  "// Placez le reset_token (depuis l’email) dans la variable d’environnement.",
                  "// pm.environment.set('reset_token', '<TOKEN>');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Reset Password (avec token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/auth/reset-password", "host": ["{{base_url}}"], "path": ["auth","reset-password"] },
            "body": {
              "mode": "raw",
              "raw": "{ \"token\": \"{{reset_token}}\", \"new_password\": \"{{new_password}}\" }"
            },
            "description": "Change le mot de passe avec le token signé reçu par email."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if(!pm.environment.get('reset_token')){",
                  "  pm.execution.setNextRequest(null);",
                  "  console.warn('⚠️ reset_token manquant. Renseignez-le depuis l’email.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": { "exec": ["pm.test(\"200 OK\", ()=> pm.response.to.have.status(200));"], "type": "text/javascript" }
            }
          ]
        }
      ]
    },
